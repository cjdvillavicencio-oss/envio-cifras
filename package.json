{
  "name": "envio-de-cifras-desktop",
  "version": "1.0.0",
  "description": "Aplicación local de envío de cifras con OneDrive y Outlook.",
  "private": true,
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "pnpm build:electron && concurrently -k \"vite --config frontend/vite.config.ts\" \"wait-on tcp:4174 && electron .\"",
    "build:renderer": "vite build --config frontend/vite.config.ts",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "pnpm build:renderer && pnpm build:electron",
    "typecheck": "tsc --noEmit -p electron/tsconfig.json && tsc --noEmit -p frontend/tsconfig.json",
    "package:win": "pnpm build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@azure/msal-node": "^3.8.0",
    "@tanstack/react-query": "^5.90.21",
    "better-sqlite3": "^12.8.0",
    "lucide-react": "^0.545.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.27.3",
    "typescript": "~5.9.2",
    "vite": "^7.3.2",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "es.mueblesboom.enviocifras",
    "productName": "Envío de Cifras",
    "directories": { "output": "release" },
    "files": ["frontend/dist/**", "dist-electron/**", "package.json"],
    "asarUnpack": ["node_modules/better-sqlite3/**"],
    "win": { "icon": "build/icon.ico", "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "artifactName": "Envio-de-Cifras-Setup-${version}.${ext}" }
  }
}
